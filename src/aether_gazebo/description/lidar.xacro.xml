<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_height" value="0.055" />
  <xacro:property name="lidar_radius" value="0.0508" />
  <xacro:property name="lidar_mass" value="0.125" />

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}" />
      </geometry>
      <material name="red" />
      <!-- <origin xyz="0 0 0" rpy="${pi / 2} 0 0" /> -->
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}" />
      </geometry>
      <!-- <origin xyz="0 0 0" rpy="${pi / 2} 0 0" /> -->
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}" />
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 ${(base_height + lidar_height)/2} " rpy="0 0 0" />
  </joint>

