<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro='http://www.ros.org/wiki/xacro'>

  <!-- MATERIALS -->

  <material name='white'>
    <color rgba='1 1 1 1' />
  </material>

  <material name='orange'>
    <color rgba='1 0.3 0.1 1' />
  </material>

  <material name='blue'>
    <color rgba='0.2 0.2 1 1' />
  </material>

  <material name='black'>
    <color rgba='0 0 0 1' />
  </material>

  <material name='red'>
    <color rgba='1 0 0 1' />
  </material>


  <!-- CONSTANTS -->

  <xacro:property name='base_height' value='0.1' />
  <xacro:property name='base_width' value='0.16' />
  <xacro:property name='base_length' value='0.23' />
  <xacro:property name="base_mass" value="0.052" />
  <xacro:property name='base_z_offset' value='0.0175' />

  <xacro:property name='wheel_radius' value='0.0325' />
  <xacro:property name='wheel_width' value='0.025' />
  <xacro:property name="wheel_mass" value="0.029" />
  <xacro:property name="wheel_y_offset" value="0.003" />


  <!-- LINKS AND JOINTS -->


  <link name='base_link'>
    <visual>
      <!-- <origin xyz='-${base_length / 4} 0 ${base_height / 2}' rpy='0 0 0' /> -->
      <origin xyz='0 0 0' rpy='0 0 0' />
      <geometry>
        <box size='${base_length} ${base_width} ${base_height}' />
      </geometry>
      <material name='white' />
    </visual>

    <collision>
      <!-- <origin xyz='-${base_length / 4} 0 ${base_height / 2}' rpy='0 0 0 ' /> -->
      <origin xyz='0 0 0' rpy='0 0 0' />
      <geometry>
        <box size='${base_length} ${base_width} ${base_height}' />
      </geometry>
    </collision>

    <xacro:box_inertia m="${base_mass}" w="${base_width}" h="${base_height}" d="${base_length}" />
  </link>

  <link name='base_footprint' />

  <joint name='base_joint' type='fixed'>
    <parent link='base_link' />
    <child link='base_footprint' />
    <origin xyz='0 0 -${base_height/2 + base_z_offset}' rpy='0 0 0' />
  </joint>

  <!-- Wheels -->

  <xacro:macro name='wheel' params='prefix origin_xyz'>
    <link name='${prefix}_link'>
      <visual>
        <origin xyz='0 0 0' rpy='-${pi/2} 0 0' />
        <geometry>
          <cylinder radius='${wheel_radius}' length='${wheel_width}' />
          <!-- <sphere radius='${radius}' /> -->
        </geometry>
        <material name='blue' />
      </visual>

      <collision>
        <origin xyz='0 0 0' rpy='-${pi/2} 0 0' />
        <geometry>
          <cylinder radius='${wheel_radius}' length='${wheel_width}' />
        </geometry>
      </collision>

      <xacro:cylinder_inertia m="${wheel_mass}" h="${wheel_width}" r="${wheel_radius}" />
    </link>

    <joint name='${prefix}_joint' type='continuous'>
      <parent link='base_link' />
      <child link='${prefix}_link' />
      <origin
        xyz='${origin_xyz}'
        rpy='0 0 0' />
      <axis xyz='0 1 0' />
    </joint>
  </xacro:macro>

  <xacro:macro name='caster_wheel' params='prefix origin_xyz'>
    <link name='${prefix}_link'>
      <visual>
        <origin xyz='0 0 0' rpy='0 0 0' />
        <geometry>
          <sphere radius='${wheel_radius}' />
        </geometry>
        <material name='blue' />
      </visual>

      <collision>
        <origin xyz='0 0 0' rpy='0 0 0' />
        <geometry>
          <!-- <cylinder radius='${radius}' length='${length}' /> -->
          <sphere radius='${wheel_radius}' />
        </geometry>
      </collision>

      <xacro:sphere_inertia m="${wheel_mass}" r="${wheel_radius}" />
    </link>

    <joint name='${prefix}_joint' type='fixed'>
      <parent link='base_link' />
      <child link='${prefix}_link' />
      <origin xyz='${origin_xyz}' rpy='0 0 0' />
    </joint>
  </xacro:macro>

  <xacro:wheel
    prefix='wheel_front_left'
    origin_xyz='${base_length/4} ${(base_width + wheel_width)/2 + wheel_y_offset} -${base_height/2 + base_z_offset - wheel_radius}' />

  <xacro:wheel
    prefix='wheel_front_right'
    origin_xyz='${base_length/4} -${(base_width + wheel_width)/2 + wheel_y_offset} -${base_height/2 + base_z_offset - wheel_radius}' />

  <xacro:caster_wheel
    prefix='wheel_rear_left'
    origin_xyz='-${base_length/4} ${(base_width + wheel_width)/2 + wheel_y_offset} -${base_height/2 + base_z_offset - wheel_radius}' />

  <xacro:caster_wheel
    prefix='wheel_rear_right'
    origin_xyz='-${base_length/4} -${(base_width + wheel_width)/2 + wheel_y_offset} -${base_height/2 + base_z_offset - wheel_radius}' />
</robot>
