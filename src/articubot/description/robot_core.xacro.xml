<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro.xml" />

  <!-- MATERIALS -->

  <material name="white">
    <color rgba="1 1 1 1" />
  </material>

  <material name="orange">
    <color rgba="1 0.3 0.1 1" />
  </material>

  <material name="blue">
    <color rgba="0.2 0.2 1 1" />
  </material>

  <material name="black">
    <color rgba="0 0 0 1" />
  </material>


  <!-- CONSTANTS -->

  <xacro:property name="base_height" value="0.035" />
  <xacro:property name="base_width" value="0.15" />
  <xacro:property name="base_length" value="0.25" />
  <!-- <xacro:property name="base2_offset_z" value="0.0325" /> -->
  <!-- <xacro:property name="base_offset_z" value="0.0175" /> -->
  <xacro:property name="wheel_radius" value="0.03" />
  <xacro:property name="wheel_length" value="0.025" />


  <!-- LINKS AND JOINTS -->

  <!-- Base Link -->
  <link name="base_link">
  </link>


  <!-- Chassis Link -->
  <link name="chassis">
    <visual>
      <origin xyz="${base_length / 2} 0 0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="${base_length / 2} 0 0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.5" x="${base_length}" y="${base_width}" z="${base_height}">
      <origin xyz="${base_length / 2} 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />
    <origin xyz="-${base_length / 2} 0 0" />
  </joint>

  <!-- Wheels -->

  <xacro:macro name="wheel" params="name radius length origin_xyz parent_link">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${radius}" length="${length}" />
        </geometry>
        <material name="blue" />
        <!-- <origin xyz="0 0 0" rpy="${pi / 2} 0 0" /> -->
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${radius}" length="${length}" />
        </geometry>
        <!-- <origin xyz="0 0 0" rpy="${pi / 2} 0 0" /> -->
      </collision>
      <xacro:inertial_cylinder mass="0.1" length="${length}" radius="${radius}">
        <origin xyz="0 0 0" rpy="0 0 0" />
      </xacro:inertial_cylinder>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent_link}" />
      <child link="${name}" />
      <origin
        xyz="${origin_xyz}"
        rpy="-${pi / 2} 0 0" />
      <axis xyz="0 0 1" />
    </joint>
  </xacro:macro>

  <!--Back
  left wheel-->
  <xacro:wheel
    name="rear_left_wheel"
    parent_link="base_link"
    radius="${wheel_radius}"
    length="${wheel_length}"
    origin_xyz="-${base_length / 4} ${(base_width + wheel_length) / 2} 0" />

  <!--Back
  right wheel-->
  <xacro:wheel
    name="rear_right_wheel"
    parent_link="base_link"
    radius="${wheel_radius}"
    length="${wheel_length}"
    origin_xyz="-${base_length / 4} -${(base_width + wheel_length) / 2} 0" />

  <!--front
  left wheel-->
  <xacro:wheel
    name="front_left_wheel"
    parent_link="base_link"
    radius="${wheel_radius}" 
    length="${wheel_length}"
    origin_xyz="${base_length / 4} ${(base_width + wheel_length) / 2} 0" />

  <!--front
  right wheel-->
  <xacro:wheel
    name="front_right_wheel"
    parent_link="base_link"
    radius="${wheel_radius}"
    length="${wheel_length}"
    origin_xyz="${base_length / 4} -${(base_width + wheel_length) / 2} 0" />

</robot>
