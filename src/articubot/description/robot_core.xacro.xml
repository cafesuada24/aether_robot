  <!--   name="rear_right_wheel" -->
  <!--   parent_link="base_link" -->
  <!--   radius="${wheel_radius}" -->
  <!--   length="${wheel_length}" -->
  <!--   origin_xyz="-${base_length / 4} -${(base_width + wheel_length) / 2} 0" /> -->
</robot>
