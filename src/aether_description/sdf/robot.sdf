<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.8" xmlns:xacro="http://ros.org/wiki/xacro">
  <model name="aether_bot" canonical_link="base_link">

    <!-- >> PROPERTIES >> -->

    <xacro:arg name="sim_mode" default="False" />

    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="base_width" value="0.16" />
    <xacro:property name="base_length" value="0.23" />
    <xacro:property name="base_mass" value="0.052" />
    <xacro:property name="base_zoff" value="0.0175" />

    <xacro:property name="wheel_radius" value="0.0325" />
    <xacro:property name="wheel_width" value="0.025" />
    <xacro:property name="wheel_mass" value="0.029" />
    <xacro:property name="wheel_yoff" value="0.003" />

    <!-- << PROPERTIES -->


    <!-- >> INERTIAS >> -->

    <xacro:macro name="box_inertia" params="m w h d">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 ${pi/2}</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (h*h + d*d)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (w*w + d*d)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/12) * (w*w + h*h)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 0</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (3*r*r + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (3*r*r + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/2) * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r">
      <inertial>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(2/5) * m * (r*r)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(2/5) * m * (r*r)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(2/5) * m * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <!-- << INERTIAS << -->

    <link name="base_link">
      <must_be_base_link>true</must_be_base_link>
      <visual name="base_link_visual">
        <geometry>
          <box>
            <size>${base_length} ${base_width} ${base_height}</size>
          </box>
        </geometry>
      </visual>
      <collision name="base_link_collision">
        <geometry>
          <box>
            <size>${base_length} ${base_width} ${base_height}</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="base_footprint">
      <pose relative_to="base_joint" />
      <xacro:box_inertia m="${base_mass}" w="${base_width}" h="${base_height}" d="${base_length}" />
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_footprint</child>
      <pose relative_to="base_link">0 0 -${base_height/2 + base_zoff} 0 0 0</pose>
    </joint>

    <xacro:macro name="wheel" params="prefix origin_xyz">
      <link name="${prefix}_link">
        <pose relative_to="${prefix}_joint" />

        <visual name="${prefix}_link_visual">
          <pose relative_to="${prefix}_link">0 0 0 -${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
        </visual>

        <collision name="${prefix}_link_collision">
          <pose relative_to="${prefix}_link">0 0 0 -${pi/2} 0 0</pose>
          <geometry>
            <!-- <sphere> -->
            <!--   <radius>${wheel_radius}</radius> -->
            <!-- </sphere> -->
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100000</mu>
                <mu2>100000</mu2>
                <fdir1>0 0 0</fdir1>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+5</kp>
                <kd>1</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <xacro:cylinder_inertia m="${wheel_mass}" h="${wheel_width}" r="${wheel_radius}" />
      </link>

      <joint name="${prefix}_joint" type="revolute">
        <parent>base_link</parent>
        <child>${prefix}_link</child>
        <pose relative_to="base_link">${origin_xyz} 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>

            <effort>20</effort>
            <!-- <lower>-inf</lower> -->
            <!-- <upper>inf</upper> -->
          </limit>
        </axis>
      </joint>
    </xacro:macro>

    <xacro:macro name="caster_wheel" params="prefix origin_xyz">
      <link name="${prefix}_link">
        <pose relative_to="${prefix}_joint" />

        <visual name="${prefix}_visual">
          <pose relative_to="${prefix}_link">0 0 0 -${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
        </visual>

        <collision name="${prefix}_collision">
          <pose relative_to="${prefix}_link">0 0 0 -${pi/2} 0 0</pose>
          <geometry>
            <sphere>
              <radius>${wheel_radius}</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.001</mu>
                <mu2>0.001</mu2>
              </ode>
            </friction>
            <!-- <contact> -->
            <!--   <ode> -->
            <!--     <soft_cfm>0</soft_cfm> -->
            <!--     <soft_erp>0.2</soft_erp> -->
            <!--     <kp>1e+5</kp> -->
            <!--     <kd>1</kd> -->
            <!--     <max_vel>0.01</max_vel> -->
            <!--     <min_depth>0.001</min_depth> -->
            <!--   </ode> -->
            <!-- </contact> -->
          </surface>
        </collision>

        <xacro:sphere_inertia m="${wheel_mass}" r="${wheel_radius}" />
      </link>

      <joint name="${prefix}_joint" type="fixed">
        <parent>base_link</parent>
        <child>${prefix}_link</child>
        <pose relative_to="base_link">${origin_xyz} 0 0 0</pose>
      </joint>
    </xacro:macro>

    <xacro:wheel
      prefix="wheel_front_left"
      origin_xyz="${base_length/4} ${(base_width + wheel_width)/2 + wheel_yoff} -${base_height/2 + base_zoff - wheel_radius}" />

    <xacro:wheel
      prefix="wheel_front_right"
      origin_xyz="${base_length/4} -${(base_width + wheel_width)/2 + wheel_yoff} -${base_height/2 + base_zoff - wheel_radius}" />

    <!-- <xacro:caster_wheel -->
    <!--   prefix="caster_wheel" -->
    <!--   origin_xyz="-${base_length/4} 0 -${base_height/2 + base_zoff - wheel_radius}" /> -->

    <xacro:caster_wheel
      prefix="wheel_rear_left"
      origin_xyz="-${base_length/4} ${(base_width + wheel_width)/2 + wheel_yoff} -${base_height/2 + base_zoff - wheel_radius}" />
    <!---->
    <xacro:caster_wheel
      prefix="wheel_rear_right"
      origin_xyz="-${base_length/4} -${(base_width + wheel_width)/2 + wheel_yoff} -${base_height/2 + base_zoff - wheel_radius}" />


    <!-- IMU -->

    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>imu_link</child>
      <pose relative_to='base_link'></pose>
    </joint>

    <link name='imu_link'>
      <pose relative_to='imu_joint' />
      <visual name="imu_link_visual">
        <geometry>
          <box>
            <size>
              0.01 0.01 0.01
            </size>
          </box>
        </geometry>
      </visual>

      <collision name="imu_link_collision">
        <geometry>
          <box>
            <size>
              0.01 0.01 0.01
            </size>
          </box>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.05" w="0.01" d="0.01" h="0.01" />

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Lidar -->

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose relative_to="base_link">0.0 0.0 ${(base_height+0.055)/2} 0 0 0</pose>
    </joint>

    <link name='lidar_link'>
      <pose relative_to="lidar_joint" />
      <visual name="lidar_link_visual">
        <geometry>
          <cylinder>
            <radius>0.0508</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="lidar_link_collision">
        <geometry>
          <cylinder>
            <radius>0.0508</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
      </collision>

      <xacro:cylinder_inertia m="0.125" r="0.0508" h="0.055" />

      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>5</update_rate>
        <topic>lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.000000</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20000</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>


    <!-- Camera -->

    <link name='front_camera_link'>
      <visual name='front_camera_visual'>
        <geometry>
          <box>
            <size>0.0016 0.09 0.018</size>
          </box>
        </geometry>
      </visual>

      <sensor name='front_camera' type='camera'>
        <visualize>true</visualize>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>camera/image_raw</topic>

        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <optical_frame_id>camera_optical_link</optical_frame_id>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name='front_camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>front_camera_link</child>
      <pose relative_to='base_link'>${base_length / 2 + 0.0008} 0 0 0 0 0</pose>
    </joint>

    <link name='front_camera_optical_link'></link>
    <joint name='front_camera_optical_joint' type='fixed'>
      <parent>front_camera_link</parent>
      <child>front_camera_optical_link</child>
      <pose relative_to='front_camera_link'>0 0 0 -${pi / 2} 0 -${pi / 2}</pose>
    </joint>


    <!-- >> PLUGINS >> -->

    <!-- <plugin filename='gz_ros2_control-system'
    name='gz_ros2_control::GazeboSimROS2ControlPlugin'> -->
    <!--   <parameters>$(find articubot)/params/controllers.yaml</parameters> -->
    <!-- </plugin> -->


    <xacro:unless value="${$(arg sim_mode)}">
      <ros2_control name="AetherControl" type="system">
        <hardware>
          <plugin>aether_driver/DiffDriveArduino</plugin>
          <param name="left_wheel_name">wheel_front_left_joint</param>
          <param name="right_wheel_name">wheel_front_right_joint</param>
          <param name="loop_rate_ms">30</param>
          <param name="baud_rate">57600</param>
          <param name="timeout_ms">1000</param>
          <param name="device">/dev/ttyUSB0</param>
          <param name="enc_counts_per_rev">40</param>
        </hardware>

        <joint name="wheel_front_left_joint">
          <command_interface name="velocity">
            <param name="min">-0.35</param>
            <param name="max">0.8</param>
          </command_interface>

          <state_interface name="velocity" />
          <state_interface name="position" />
        </joint>

        <joint name="wheel_front_right_joint">
          <command_interface name="velocity">
            <param name="min">-0.35</param>
            <param name="max">0.8</param>
          </command_interface>

          <state_interface name="velocity" />
          <state_interface name="position" />
        </joint>

      </ros2_control>
    </xacro:unless>

    <xacro:if value="${$(arg sim_mode)}">
      <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="wheel_front_left_joint">
          <command_interface name="velocity">
            <param name="min">-0.35</param>
            <param name="max">0.8</param>
          </command_interface>

          <state_interface name="velocity" />
          <state_interface name="position" />
        </joint>

        <joint name="wheel_front_right_joint">
          <command_interface name="velocity">
            <param name="min">-0.35</param>
            <param name="max">0.8</param>
          </command_interface>

          <state_interface name="velocity" />
          <state_interface name="position" />
        </joint>

      </ros2_control>
    </xacro:if>

    <plugin filename='gz_ros2_control-system' name='gz_ros2_control::GazeboSimROS2ControlPlugin'>
      <!-- <parameters>$(find aether_gazebo)/params/controllers.yaml</parameters> -->
    </plugin>
    <!-- <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"> -->
    <!---->
    <!--   <left_joint>wheel_front_left_joint</left_joint> -->
    <!--   <right_joint>wheel_front_right_joint</right_joint> -->
    <!---->
    <!---->
    <!--   <wheel_separation>${base_width + 2*wheel_width + wheel_width}</wheel_separation> -->
    <!--   <wheel_radius>${wheel_radius}</wheel_radius> -->
    <!---->
    <!--   <max_linear_acceleration>1.0</max_linear_acceleration> -->
    <!---->
    <!--   <topic>/cmd_vel</topic> -->
    <!--   <odom_topic>/odom</odom_topic> -->
    <!--   <tf_topic>/tf</tf_topic> -->
    <!---->
    <!--   <frame_id>odom</frame_id> -->
    <!--   <child_frame_id>base_link</child_frame_id> -->
    <!---->
    <!--   <odom_publisher_frequency>30</odom_publisher_frequency> -->
    <!-- </plugin> -->

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
    </plugin>

    <!-- << PLUGINS << -->
  </model>
</sdf>
